    def refresh_free_list(self):
        chosen = {self.fl.get(i) for i in self.fl.curselection()}
        self.fl.delete(0, "end")
        for i, s in enumerate(self.store.sources):
            self.fl.insert("end", s["name"])
            self.fl.itemconfig(i, background=self.source_color(i))
            if s["name"] in chosen:
                self.fl.selection_set(i)
 
    def find_free(self):
        names = [self.fl.get(i) for i in self.fl.curselection()]
        if not names:
            messagebox.showinfo("Pick calendars", "Select at least one calendar to check.")
            return
        try:
            start = datetime.strptime(self.f_start.get().strip(), "%Y-%m-%d").date()
            days = max(1, min(60, int(self.f_days.get())))
            t_from = datetime.strptime(self.f_from.get().strip(), "%H:%M").time()
            t_to = datetime.strptime(self.f_to.get().strip(), "%H:%M").time()
            min_len = max(5, int(self.f_len.get()))
            if t_to <= t_from:
                raise ValueError
        except ValueError:
            messagebox.showwarning("Check options", "Use YYYY-MM-DD for the date, HH:MM for times "
                                   "(end after start), and whole numbers for days and minutes.")
            return
        unsynced = [n for n in names if n not in self.store.data["events"]]
        if unsynced:
            messagebox.showwarning("Not synced yet", "These calendars have no events yet, so they'd look "
                                   "completely free:\n\n" + "\n".join(unsynced) + "\n\nSync them first.")
            return
        events = [e for e in self.store.all_events(only_visible=False)
                  if e["source"] in names and not e["all_day"]]
        self.fv.delete(*self.fv.get_children())
        self._slots = {}
        for i in range(days):
            day = start + timedelta(days=i)
            if day.weekday() >= 5 and not self.f_weekends.get():
                continue
            for s, e in free_slots(events, day, t_from, t_to, min_len):
                mins = int((e - s).total_seconds() // 60)
                length = f"{mins // 60}h {mins % 60:02d}m" if mins >= 60 else f"{mins} min"
                iid = self.fv.insert("", "end", values=(f"{day:%a %d %b}", f"{s:%H:%M}", f"{e:%H:%M}", length))
                self._slots[iid] = (s, e)
        n = len(self._slots)
        self.status.set(f"{n} common free slot(s) across {len(names)} calendar(s)" if n
                        else "No common free time found — try a longer range or shorter minimum length.")
        self._draw_heatmap(names, events, start, days, t_from, t_to)
 
    def _draw_heatmap(self, names, events, start, days, t_from, t_to, step=30):
        """Grid of days × 30-minute slots, shaded by the share of people who are free."""
        cv = self.hv
        cv.delete("all")
        busy_by_person = {n: [(self._dt(e["start"]), self._dt(e["end"])) for e in events if e["source"] == n]
                          for n in names}
        dates = [start + timedelta(days=i) for i in range(days)
                 if self.f_weekends.get() or (start + timedelta(days=i)).weekday() < 5]
        t0, t1 = t_from.hour * 60 + t_from.minute, t_to.hour * 60 + t_to.minute
        rows = list(range(t0, t1, step))
        gut, head, cw, ch = 52, 34, 66, 22
        cells = {}
        for c, d in enumerate(dates):
            cv.create_rectangle(gut + c * cw, 0, gut + (c + 1) * cw, head, fill="#e6edf5", outline="#c9d3df")
            cv.create_text(gut + c * cw + cw / 2, head / 2, text=f"{d:%a}\n{d:%d %b}",
                           font=("TkDefaultFont", 8, "bold"), justify="center")
        for r, minute in enumerate(rows):
            y = head + r * ch
            if minute % 60 == 0:
                cv.create_text(gut - 6, y, text=f"{minute // 60:02d}:00", anchor="e", fill="#6b7280",
                               font=("TkDefaultFont", 8))
            for c, d in enumerate(dates):
                s = datetime.combine(d, time()) + timedelta(minutes=minute)
                e = min(s + timedelta(minutes=step), datetime.combine(d, t_to))
                free = [n for n in names if not any(bs < e and be > s for bs, be in busy_by_person[n])]
                busy = [n for n in names if n not in free]
                x0 = gut + c * cw
                cv.create_rectangle(x0, y, x0 + cw, y + ch, fill=heat_color(len(free) / len(names)), outline="white")
                if len(names) > 1:
                    cv.create_text(x0 + cw / 2, y + ch / 2, text=f"{len(free)}/{len(names)}",
                                   font=("TkDefaultFont", 8), fill="#374151")
                cells[(r, c)] = (s, e, free, busy)
        self._heat_meta = {"gut": gut, "head": head, "cw": cw, "ch": ch, "cells": cells}
        cv.configure(scrollregion=(0, 0, gut + len(dates) * cw + 4, head + len(rows) * ch + 4))
        cv.xview_moveto(0)
        cv.yview_moveto(0)
 
    def _heat_click(self, event):
        m = self._heat_meta
        if not m:
            return
        x, y = self.hv.canvasx(event.x), self.hv.canvasy(event.y)
        cell = m["cells"].get((int((y - m["head"]) // m["ch"]), int((x - m["gut"]) // m["cw"])))
        if not cell:
            return
        s, e, free, busy = cell
        text = f"{s:%A %d %b}, {s:%H:%M}–{e:%H:%M}\n\nFree: {', '.join(free) or '—'}\nBusy: {', '.join(busy) or '—'}"
        if not busy:
            if messagebox.askyesno("Everyone is free", text + "\n\nAdd a study session at this time?"):
                self._add_study_task(s)
        else:
            messagebox.showinfo("Availability", text)
 
    def _chosen_slots(self):
        sel = self.fv.selection() or ()
        return [self._slots[i] for i in sel if i in self._slots]
 
    def copy_slots(self):
        slots = self._chosen_slots()
        if not slots:
            messagebox.showinfo("Nothing selected", "Select one or more free slots first.")
            return
        text = "Study group — I'm free:\n" + "\n".join(f"• {s:%a %d %b}, {s:%H:%M}–{e:%H:%M}" for s, e in slots)
        self.clipboard_clear()
        self.clipboard_append(text)
        self.status.set("Copied — paste it into your group chat.")
 
    def slot_to_task(self):
        slots = self._chosen_slots()
        if not slots:
            messagebox.showinfo("Nothing selected", "Select a free slot first.")
            return
        self._add_study_task(slots[0][0])
 
    def _add_study_task(self, s):
        """Open the task form pre-filled for a study session starting at datetime `s`."""
        fields = [("title", "Task", "Study group", "entry"), ("course", "Course", "", "entry"),
                  ("due", "When (YYYY-MM-DD HH:MM)", s.strftime(DUE_FMT), "entry"),
                  ("priority", "Priority", "Medium", "combo", ["Low", "Medium", "High"])]
        def ok(v):
            if not self._validate_task(v):
                return False
            self.store.tasks.append({"id": uuid.uuid4().hex, "done": False, **v})
            self.store.save()
            self.refresh_tasks()
            self.status.set("Study session added to your tasks.")
        FormDialog(self, "Add study session", fields, ok)
 
    # ---------------- syncing ----------------
    def sync_all(self):
        if not self.store.sources:
            self.status.set("No timetable sources yet — add one in the “Timetable Sources” tab.")
            self.nb.select(2)
            return
        self.sync_sources(list(self.store.sources))
 
    def sync_selected(self):
        s = self._selected_source()
        if s:
            self.sync_sources([s])
 
    def sync_sources(self, sources):
        for s in sources:
            self.syncing += 1
            threading.Thread(target=self._worker, args=(s,), daemon=True).start()
        self.sync_btn.state(["disabled"])
        self.status.set(f"Syncing {len(sources)} source(s)…")
 
    def _worker(self, s):
        headers = {}
        if s.get("headers") and ":" in s["headers"]:
            k, _, v = s["headers"].partition(":")
            headers[k.strip()] = v.strip()
        try:
            self.q.put(("ok", s["name"], fetch_timetable(s["url"], headers)))
        except urllib.error.HTTPError as e:
            self.q.put(("err", s["name"], f"HTTP {e.code} {e.reason}"))
        except urllib.error.URLError as e:
            self.q.put(("err", s["name"], f"Connection problem: {e.reason}"))
        except Exception as e:
            self.q.put(("err", s["name"], str(e)))
 
    def _poll_queue(self):
        try:
            while True:
                kind, name, payload = self.q.get_nowait()
                self.syncing -= 1
                if kind == "ok":
                    self.store.data["events"][name] = payload
                    self.store.data["last_sync"][name] = datetime.now().strftime("%d %b %H:%M")
                    self.store.save()
                    self.status.set(f"“{name}”: {len(payload)} events loaded")
                else:
                    self.status.set(f"“{name}” failed: {payload}")
                    messagebox.showerror("Sync failed", f"{name}\n\n{payload}")
                if self.syncing <= 0:
                    self.sync_btn.state(["!disabled"])
                self.refresh_all()
        except queue.Empty:
            pass
        self.after(150, self._poll_queue)
 
    # ---------------- misc ----------------
    def _tick(self):
        self.update_next_up()
        self.refresh_tasks()
        if self.view_var.get() != "List":
            self.refresh_timetable()   # keeps the red "now" line and due markers current
        self.after(60_000, self._tick)
 
    def update_next_up(self):
        now = datetime.now()
        for e in self.store.all_events():
            if e["all_day"] or e["owner"] != "Me":  # classmates' classes aren't "my" next up
                continue
            s = datetime.strptime(e["start"], ISO)
            if s >= now:
                delta = s - now
                h, m = divmod(int(delta.total_seconds() // 60), 60)
                when = f"in {h}h {m}m" if h else f"in {m} min"
                if s.date() != now.date():
                    when = f"{s:%a %H:%M}"
                loc = f" @ {e['location']}" if e["location"] else ""
                self.next_var.set(f"Next up: {e['title']}{loc} — {when}")
                return
        self.next_var.set("Next up: nothing scheduled")
 
    def refresh_all(self):
        self.refresh_timetable()
        self.refresh_tasks()
        self.refresh_sources()
        self.update_next_up()
 
    def _quit(self):
        self.store.save()
        self.destroy()
 
 
