    def add_source(self):
        def ok(v):
            if not v["url"] or not v["name"]:
                messagebox.showwarning("Missing info", "Name and URL are required.")
                return False
            if any(s["name"] == v["name"] for s in self.store.sources):
                messagebox.showwarning("Duplicate", "A source with that name already exists.")
                return False
            v["visible"] = True
            self.store.sources.append(v)
