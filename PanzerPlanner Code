    def _validate_task(self, v):
        if not v["title"]:
            messagebox.showwarning("Missing title", "Please enter a task title.")
            return False
        if v["due"]:
            try:
                datetime.strptime(v["due"], DUE_FMT)
            except ValueError:
                try:
                    v["due"] = datetime.strptime(v["due"], "%Y-%m-%d").strftime("%Y-%m-%d 23:59")
                except ValueError:
                    messagebox.showwarning("Bad date", "Use YYYY-MM-DD HH:MM (e.g. 2026-11-02 17:00).")
                    return False
        return True
 
    def add_task(self):
        def ok(v):
            if not self._validate_task(v):
                return False
            self.store.tasks.append({"id": uuid.uuid4().hex, "done": False, **v})
            self.store.save()
            self.refresh_tasks()
        FormDialog(self, "Add task", self._task_fields(), ok)
 
    def _selected_task(self):
        sel = self.tv.selection()
        return next((t for t in self.store.tasks if t["id"] == sel[0]), None) if sel else None
 
    def edit_task(self):
        t = self._selected_task()
        if not t:
            return
        def ok(v):
            if not self._validate_task(v):
                return False
            t.update(v)
            self.store.save()
            self.refresh_tasks()
        FormDialog(self, "Edit task", self._task_fields(t), ok)
 
    def toggle_task(self):
        t = self._selected_task()
        if t:
            t["done"] = not t["done"]
            self.store.save()
            self.refresh_tasks()
 
    def delete_task(self):
        t = self._selected_task()
        if t and messagebox.askyesno("Delete", f"Delete “{t['title']}”?"):
            self.store.tasks.remove(t)
            self.store.save()
            self.refresh_tasks()
 
    def refresh_tasks(self):
        self.tv.delete(*self.tv.get_children())
        now = datetime.now()
        prio = {"High": 0, "Medium": 1, "Low": 2}
        tasks = sorted(self.store.tasks, key=lambda t: (t["done"], t["due"] or "9999", prio.get(t["priority"], 1)))
        for t in tasks:
            if t["done"] and not self.show_done.get():
                continue
            tag = ()
            if t["done"]:
                tag = ("done",)
            elif t["due"]:
                due = datetime.strptime(t["due"], DUE_FMT)
                tag = ("overdue",) if due < now else (("soon",) if due - now < timedelta(days=2) else ())
            self.tv.insert("", "end", iid=t["id"], tags=tag,
                           values=("✔" if t["done"] else "", t["title"], t["course"], t["due"], t["priority"]))
 
