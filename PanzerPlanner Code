# ----------------------------------------------------------------------------
# iCalendar parsing
# ----------------------------------------------------------------------------
def normalise_url(url: str) -> str:
    """webcal:// and webcals:// are just https:// in disguise."""
    url = url.strip()
    low = url.lower()
    if low.startswith("webcal://") or low.startswith("webcals://"):
        url = "https://" + url.split("://", 1)[1]
    return url
 
 
def _unescape(text: str) -> str:
    return (text.replace("\\n", "\n").replace("\\N", "\n")
                .replace("\\,", ",").replace("\\;", ";").replace("\\\\", "\\"))
 
 
def _parse_dt(value: str, params: dict):
    """Return (naive local datetime, all_day)."""
    value = value.strip()
    if params.get("VALUE") == "DATE" or (len(value) == 8 and "T" not in value):
        d = datetime.strptime(value[:8], "%Y%m%d")
        return d, True
    if value.endswith("Z"):
        dt = datetime.strptime(value, "%Y%m%dT%H%M%SZ")
        from datetime import timezone
        dt = dt.replace(tzinfo=timezone.utc).astimezone().replace(tzinfo=None)
        return dt, False
    dt = datetime.strptime(value[:15], "%Y%m%dT%H%M%S")
    tzid = params.get("TZID")
    if tzid and ZoneInfo:
        try:
            dt = dt.replace(tzinfo=ZoneInfo(tzid)).astimezone().replace(tzinfo=None)
        except Exception:
            pass  # unknown zone: treat as local time
    return dt, False
 
 
def _unfold(text: str):
    return re.sub(r"\r?\n[ \t]", "", text).splitlines()
 
 
def _split_prop(line: str):
    head, _, value = line.partition(":")
    parts = head.split(";")
    name = parts[0].upper()
    params = {}
    for p in parts[1:]:
        k, _, v = p.partition("=")
        params[k.upper()] = v.strip('"')
    return name, params, value
 
 
def _parse_rrule(value: str) -> dict:
    rule = {}
    for part in value.split(";"):
        k, _, v = part.partition("=")
        rule[k.upper()] = v
    return rule
 
 
def _add_months(d: datetime, n: int):
    m = d.month - 1 + n
    y, m = d.year + m // 12, m % 12 + 1
    try:
        return d.replace(year=y, month=m)
    except ValueError:
        return None
 
 
def _expand(start, rule, win_start, win_end, until_params):
    """Yield occurrence start datetimes of a recurring event within the window."""
    freq = rule.get("FREQ", "")
    interval = int(rule.get("INTERVAL", 1) or 1)
    count = int(rule["COUNT"]) if "COUNT" in rule else None
    until = None
    if "UNTIL" in rule:
        try:
            until, is_date = _parse_dt(rule["UNTIL"], until_params)
            if is_date:
                until += timedelta(days=1) - timedelta(seconds=1)
        except Exception:
            until = None
    byday = [d[-2:] for d in rule.get("BYDAY", "").split(",") if d]
    produced = 0
    limit = min(win_end, until) if until else win_end

    if freq == "WEEKLY":
        week0 = start - timedelta(days=start.weekday())
        days = sorted(WEEKDAYS.index(d) for d in byday) if byday else [start.weekday()]
        k = 0
        while k < 3000:
            base = week0 + timedelta(weeks=k * interval)
            if base > limit:
                return
            for wd in days:
                dt = base + timedelta(days=wd)
                if dt > limit:
                    return
                if dt < start:
                    continue
                produced += 1
                if count is not None and produced > count:
                    return
                if dt >= win_start:
                    yield dt
            k += 1
    elif freq in ("DAILY", "MONTHLY", "YEARLY"):
        k = 0
        while k < 5000:
            if freq == "DAILY":
                dt = start + timedelta(days=k * interval)
            elif freq == "MONTHLY":
                dt = _add_months(start, k * interval)
            else:
                dt = _add_months(start, k * interval * 12)
            k += 1
            if dt is None:
                continue
            if dt > limit:
                return
            produced += 1
            if count is not None and produced > count:
                return
            if dt >= win_start:
                yield dt
    else:
        if win_start <= start <= win_end:
            yield start
 
 
def parse_ics(text: str, back_days=60, forward_days=400):
    """Parse an .ics feed into a list of event dicts (recurrences expanded)."""
    now = datetime.now()
    win_start = now - timedelta(days=back_days)
    win_end = now + timedelta(days=forward_days)
    events, cur = [], None
    for line in _unfold(text):
        if line == "BEGIN:VEVENT":
            cur = {"props": {}, "exdates": []}
            continue
        if line == "END:VEVENT" and cur is not None:
            events.extend(_finish_event(cur, win_start, win_end))
            cur = None
            continue
        if cur is None or ":" not in line:
            continue
        name, params, value = _split_prop(line)
        if name == "EXDATE":
            for v in value.split(","):
                try:
                    cur["exdates"].append(_parse_dt(v, params)[0])
                except Exception:
                    pass
        else:
            cur["props"][name] = (params, value)
    events.sort(key=lambda e: e["start"])
    return events
 
 
def _finish_event(raw, win_start, win_end):
    p = raw["props"]
    if "DTSTART" not in p:
        return []
    try:
        start, all_day = _parse_dt(p["DTSTART"][1], p["DTSTART"][0])
        if "DTEND" in p:
            end, _ = _parse_dt(p["DTEND"][1], p["DTEND"][0])
        else:
            end = start + (timedelta(days=1) if all_day else timedelta(hours=1))
    except Exception:
        return []
    dur = end - start
 
    def text(key):
        return _unescape(p[key][1]).strip() if key in p else ""
 
    base = {
        "uid": text("UID"),
        "title": text("SUMMARY") or "(untitled)",
        "location": text("LOCATION"),
        "description": text("DESCRIPTION"),
        "all_day": all_day,
    }
    if "RRULE" in p:
        starts = _expand(start, _parse_rrule(p["RRULE"][1]), win_start, win_end,
                         p["DTSTART"][0])
    else:
        starts = [start] if win_start - dur <= start <= win_end else []
    out = []
    ex = set(raw["exdates"])
    for s in starts:
        if s in ex:
            continue
        out.append({**base, "start": s.strftime(ISO), "end": (s + dur).strftime(ISO)})
    return out
 
 
# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
class Store:
    def __init__(self, path=DATA_FILE):
        self.path = Path(path)
        self.data = {"sources": [], "tasks": [], "events": {}, "last_sync": {},
                     "settings": {"auto_sync": True}}
        self.load()
 
    def load(self):
        try:
            raw = self.path.read_text(encoding="utf-8")
        except OSError:
            return
        try:
            loaded = json.loads(raw)
        except (TypeError, ValueError):
            return
        if not isinstance(loaded, dict):
            return
        settings = loaded.get("settings")
        self.data["sources"] = loaded.get("sources", []) if isinstance(loaded.get("sources"), list) else []
        self.data["tasks"] = loaded.get("tasks", []) if isinstance(loaded.get("tasks"), list) else []
        self.data["events"] = loaded.get("events", {}) if isinstance(loaded.get("events"), dict) else {}
        self.data["last_sync"] = loaded.get("last_sync", {}) if isinstance(loaded.get("last_sync"), dict) else {}
        self.data["settings"] = {"auto_sync": True}
        if isinstance(settings, dict):
            self.data["settings"].update(settings)
        self.data["settings"].setdefault("auto_sync", True)
 
    def save(self):
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.path.write_text(json.dumps(self.data, indent=2), encoding="utf-8")
        except OSError as e:
            messagebox.showerror("Save failed", str(e))
 
    # convenience
    @property
    def sources(self):
        return self.data["sources"]
 
    @property
    def tasks(self):
        return self.data["tasks"]
 
    def all_events(self, only_visible=True):
        meta = {s["name"]: s for s in self.sources}
        evs = []
        for src, lst in self.data["events"].items():
            s = meta.get(src)
            if s is None or (only_visible and not s.get("visible", True)):
                continue
            for e in lst:
                evs.append({**e, "source": src, "owner": s.get("owner", "Me")})
        evs.sort(key=lambda e: e["start"])
        return evs
 
 
# ----------------------------------------------------------------------------
# Network
# ----------------------------------------------------------------------------
def fetch_timetable(url: str, headers=None, timeout=20):
    if headers is None:
        headers = {}
    elif not isinstance(headers, dict):
        headers = dict(headers)
    req = urllib.request.Request(normalise_url(url), headers={
        "User-Agent": "StudentPlanner/1.0 (+tkinter)",
        "Accept": "text/calendar, text/plain, */*",
        **headers,
    })
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read()
        charset = resp.headers.get_content_charset() or "utf-8"
    text = raw.decode(charset, errors="replace")
    if "BEGIN:VCALENDAR" not in text:
        raise ValueError("The URL did not return an iCalendar (.ics) feed. "
                         "You may need to log in or use the 'subscribe/export' link.")
    return parse_ics(text)
 
 
# ----------------------------------------------------------------------------
# Free-time finder
# ----------------------------------------------------------------------------
def free_slots(events, day, start_t, end_t, min_minutes):
    """Return [(start, end)] gaps on `day` (within start_t..end_t) when none of
    `events` is happening and the gap is at least `min_minutes` long."""
    ws, we = datetime.combine(day, start_t), datetime.combine(day, end_t)
    need = timedelta(minutes=min_minutes)
    busy = []
    for e in events:
        if e.get("all_day"):
            continue
        s, en = datetime.strptime(e["start"], ISO), datetime.strptime(e["end"], ISO)
        if en <= ws or s >= we:
            continue
        busy.append((max(s, ws), min(en, we)))
    busy.sort()
    out, cursor = [], ws
    for s, en in busy:
        if s - cursor >= need:
            out.append((cursor, s))
        cursor = max(cursor, en)
    if we - cursor >= need:
        out.append((cursor, we))
    return out
 
 
# ----------------------------------------------------------------------------
# View helpers (Week / Day grids and the availability heatmap)
# ----------------------------------------------------------------------------
def layout_overlaps(items):
    """Place overlapping events side by side.
 
    items: iterable of (start, end, payload).
    Returns a list of (payload, lane, lane_count, start, end): `lane` is the
    column the event sits in and `lane_count` how many columns its cluster of
    overlapping events needs, so width = column_width / lane_count.
    """
    result, cluster, lane_ends, cluster_end = [], [], [], None
 
    def flush():
        n = len(lane_ends)
        for payload, lane, s, e in cluster:
            result.append((payload, lane, n, s, e))
 
    for s, e, payload in sorted(items, key=lambda x: (x[0], x[1])):
        if cluster and s >= cluster_end:
            flush()
            cluster, lane_ends, cluster_end = [], [], None
        lane = next((i for i, le in enumerate(lane_ends) if le <= s), None)
        if lane is None:
            lane_ends.append(e)
            lane = len(lane_ends) - 1
        else:
            lane_ends[lane] = e
        cluster.append((payload, lane, s, e))
        cluster_end = e if cluster_end is None else max(cluster_end, e)
    flush()
    return result
 
 
def heat_color(fraction):
    """Blend red (nobody free, 0.0) to green (everyone free, 1.0)."""
    lo, hi = (254, 202, 202), (74, 222, 128)
    f = max(0.0, min(1.0, fraction))
    return "#%02x%02x%02x" % tuple(round(a + (b - a) * f) for a, b in zip(lo, hi))
 
 
