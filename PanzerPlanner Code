    def source_color(self, index):
        """Background colour of the source at `index` (falls back to the palette order)."""
        palette = list(COLORS.values())
        s = self.store.sources[index]
        return COLORS.get(s.get("color"), palette[index % len(palette)])
 
    def _color_of(self, name):
        for i, s in enumerate(self.store.sources):
            if s["name"] == name:
                return self.source_color(i)
        return "#e5e7eb"
 
    @staticmethod
    def _dt(text):
        return datetime.strptime(text, ISO)
 
    def _sunday(self):
        return self.cursor - timedelta(days=(self.cursor.weekday() + 1) % 7)
 
    def _events_on(self, events, day):
        return [e for e in events if self._dt(e["start"]).date() == day]
 
    def _tasks_due(self, d0, d1):
        """Unfinished tasks due between dates d0 and d1 (inclusive), soonest first."""
        out = []
        for t in self.store.tasks:
            if t["done"] or not t["due"]:
                continue
            try:
                due = datetime.strptime(t["due"], DUE_FMT)
            except ValueError:
                continue
            if d0 <= due.date() <= d1:
                out.append((due, t))
        return sorted(out, key=lambda x: x[0])
 
    def _shift(self, delta, reset=False):
        """◀ / Today / ▶ — steps by a day, week or month depending on the view."""
        if reset:
            self.cursor = date.today()
        else:
            view = self.view_var.get()
            if view == "Day":
                self.cursor += timedelta(days=delta)
            elif view == "Month":
                m = self.cursor.month - 1 + delta
                self.cursor = date(self.cursor.year + m // 12, m % 12 + 1, 1)
            else:
                self.cursor += timedelta(weeks=delta)
        self.refresh_timetable()
 
    def _on_canvas_resize(self, event):
        if abs(event.width - self._last_canvas_w) < 3:
            return
        self._last_canvas_w = event.width
        if self._redraw_job:
            self.after_cancel(self._redraw_job)
        self._redraw_job = self.after(80, self.refresh_timetable)
 
    def _goto_day(self, day):
        self.cursor = day
        self.view_var.set("Day")
        self.refresh_timetable()
 
    def refresh_timetable(self):
        self._redraw_job = None
        view = self.view_var.get()
        today = date.today()
        events = self.store.all_events()
        self._tt_events = {}
        if view == "Day":
            d0 = d1 = self.cursor
            label = f"{self.cursor:%A %d %B %Y}"
        elif view == "Month":
            d0 = self.cursor.replace(day=1)
            d1 = (d0 + timedelta(days=32)).replace(day=1) - timedelta(days=1)
            label = f"{d0:%B %Y}"
        else:  # List and Week both show Sunday–Saturday
            d0 = self._sunday()
            d1 = d0 + timedelta(days=6)
            label = f"{d0:%d %b} – {d1:%d %b %Y}"
        self.week_label.config(text=label)
 
        due = self._tasks_due(d0, d1) if view != "Month" else []
        self.due_var.set("Due: " + "; ".join(f"{t['title']} ({d:%a %H:%M})" for d, t in due) if due else "")
 
