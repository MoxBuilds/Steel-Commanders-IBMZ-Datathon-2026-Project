class FormDialog(tk.Toplevel):
    """Tiny generic form: fields = [(key, label, default, kind)], kind in entry/combo."""
 
    def __init__(self, parent, title, fields, on_ok):
        super().__init__(parent)
        self.title(title)
        self.transient(parent)
        self.resizable(False, False)
        self.vars, self.on_ok = {}, on_ok
        frm = ttk.Frame(self, padding=12)
        frm.pack(fill="both", expand=True)
        first = None
        for i, (key, label, default, kind, *opts) in enumerate(fields):
            ttk.Label(frm, text=label).grid(row=i, column=0, sticky="w", pady=3, padx=(0, 8))
            var = tk.StringVar(value=default)
            self.vars[key] = var
            if kind == "combo":
                w = ttk.Combobox(frm, textvariable=var, values=opts[0], state="readonly", width=38)
            else:
                w = ttk.Entry(frm, textvariable=var, width=40)
            w.grid(row=i, column=1, pady=3)
            first = first or w
        btns = ttk.Frame(frm)
        btns.grid(row=len(fields), column=0, columnspan=2, pady=(10, 0), sticky="e")
        ttk.Button(btns, text="Cancel", command=self.destroy).pack(side="right", padx=4)
        ttk.Button(btns, text="Save", command=self._ok).pack(side="right")
        self.bind("<Return>", lambda e: self._ok())
        self.bind("<Escape>", lambda e: self.destroy())
        assert first is not None
        first.focus_set()
        self.grab_set()
 
    def _ok(self):
        values = {k: v.get().strip() for k, v in self.vars.items()}
        if self.on_ok(values) is not False:
            self.destroy()
 
 
