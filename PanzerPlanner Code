    # ---- Week and Day views (shared time grid)
    def _hour_range(self, events, days):
        """First and last hour to show: at least 08:00–18:00, widened to fit the events."""
        lo, hi = 8, 18
        for e in events:
            if e["all_day"]:
                continue
            s, en = self._dt(e["start"]), self._dt(e["end"])
            if s.date() not in days:
                continue
            lo = min(lo, s.hour)
            if en.date() > s.date():
                hi = 24
            else:
                hi = max(hi, en.hour + (1 if en.minute or en.second else 0))
        return max(0, lo), min(24, max(hi, lo + 1))
 
    def _draw_week(self, monday, events, today):
        days = [monday + timedelta(days=i) for i in range(7)]
        columns = [{"title": f"{d:%a %d}", "date": d, "highlight": d == today,
                    "events": self._events_on(events, d)} for d in days]
        lo, hi = self._hour_range(events, set(days))
        self._draw_time_grid(columns, lo, hi)
 
    def _draw_day(self, events):
        """One column per visible calendar, so you can compare classmates side by side."""
        day = self.cursor
        todays = self._events_on(events, day)
        names = [s["name"] for s in self.store.sources if s.get("visible", True)]
        if not names:
            self.cv.create_text(20, 20, anchor="nw", text="Add a timetable source to see it here.")
            return
        columns = [{"title": n, "date": day, "fill": self._color_of(n),
                    "events": [e for e in todays if e["source"] == n]} for n in names]
        lo, hi = self._hour_range(events, {day})
        self._draw_time_grid(columns, lo, hi)
 
    def _draw_time_grid(self, columns, lo, hi):
        cv = self.cv
        width = max(cv.winfo_width(), 700 if cv.winfo_width() < 100 else 0)
        gut, head, hh = self.GRID_GUTTER, self.GRID_HEADER, self.HOUR_H
        available_width = width - gut - 4
        same_day = len({col.get("date") for col in columns}) == 1
        width_key = ("Day", tuple(col["title"] for col in columns)) if same_day else ("Week",)
        weights = self._grid_widths.setdefault(width_key, [1.0] * len(columns))
        if len(weights) != len(columns):
            weights = [1.0] * len(columns)
            self._grid_widths[width_key] = weights
        total_weight = sum(weights)
        column_widths = [available_width * weight / total_weight for weight in weights]
        column_xs = [gut]
        for col_width in column_widths:
            column_xs.append(column_xs[-1] + col_width) # pyright: ignore[reportArgumentType]
        event_font = tkfont.Font(font=("TkDefaultFont", 8))

        def fit_text(text, max_width):
            if event_font.measure(text) <= max_width:
                return text
            ellipsis = "…"
            if event_font.measure(ellipsis) > max_width:
                return ""
            while text and event_font.measure(text + ellipsis) > max_width:
                text = text[:-1]
            return text.rstrip() + ellipsis

        all_day = any(e["all_day"] for c in columns for e in c["events"])
        top = head + (18 if all_day else 0)
        bottom = top + (hi - lo) * hh
 
        for c, col in enumerate(columns):
            x0, colw = column_xs[c], column_widths[c]
            if col.get("highlight"):
                cv.create_rectangle(x0, top, x0 + colw, bottom, fill="#fffbe6", outline="")
            cv.create_rectangle(x0, 0, x0 + colw, head, fill=col.get("fill", "#e6edf5"), outline="#c9d3df")
            cv.create_text(x0 + colw / 2, head / 2, text=col["title"], font=("TkDefaultFont", 10, "bold"))
        for h in range(lo, hi + 1):
            y = top + (h - lo) * hh
            cv.create_line(gut, y, width - 4, y, fill="#e5e7eb")
            cv.create_text(gut - 6, y, text=f"{h:02d}:00", anchor="e", fill="#6b7280", font=("TkDefaultFont", 8))
        for x in column_xs:
            cv.create_line(x, head, x, bottom, fill="#e5e7eb")

        n = 0
        for c, col in enumerate(columns):
            x0, colw = column_xs[c], column_widths[c]
            # all-day strip
            ad = [e for e in col["events"] if e["all_day"]]
            if ad:
                tag = f"ev{n}"
                n += 1
                sources = {e.get("source") for e in ad if e.get("source")}
                fill = self._color_of(next(iter(sources))) if len(sources) == 1 else "#dfe7f2"
                cv.create_rectangle(x0 + 1, head, x0 + colw - 1, top, fill=fill, # type: ignore
                                    outline="#9ca3af", tags=(tag,))
                text = fit_text(" · ".join(e["title"] for e in ad), colw - 8)
                cv.create_text(x0 + 4, head + 2, anchor="nw", font=event_font, tags=(tag,), text=text)
                cv.tag_bind(tag, "<Button-1>", lambda _ev, e=ad[0]: self._show_event(e))
            # timed events, overlapping ones split into lanes
            timed = [(self._dt(e["start"]), self._dt(e["end"]), e) for e in col["events"] if not e["all_day"]]
            for e, lane, lanes, s, en in layout_overlaps(timed):
                start_h = s.hour + s.minute / 60
                end_h = hi if en.date() > s.date() else en.hour + en.minute / 60
                y0 = top + (max(start_h, lo) - lo) * hh
                y1 = max(top + (min(end_h, hi) - lo) * hh, y0 + 16)
                lane_w = (colw - 4) / lanes
                x = x0 + 2 + lane * lane_w
                tag = f"ev{n}"
                n += 1
                cv.create_rectangle(x, y0, x + lane_w - 2, y1, fill=self._color_of(e["source"]), # type: ignore
                                    outline="#9ca3af", tags=(tag,))
                text = fit_text(f"{s:%H:%M} {e['title']}", lane_w - 10)
                lines = [text] if text else []
                if e["location"] and y1 - y0 >= event_font.metrics("linespace") * 2 + 6:
                    location = fit_text(e["location"], lane_w - 10)
                    if location:
                        lines.append(location)
                cv.create_text(x + 4, y0 + 3, text="\n".join(lines), anchor="nw",
                               font=event_font, tags=(tag,))
                cv.tag_bind(tag, "<Button-1>", lambda _ev, e=e: self._show_event(e))
            # "now" line
            if col.get("date") == date.today():
                now = datetime.now()
                hnow = now.hour + now.minute / 60
                if lo <= hnow <= hi:
                    y = top + (hnow - lo) * hh
                    cv.create_line(x0, y, x0 + colw, y, fill="#dc2626", width=2)
        for boundary in range(1, len(columns)):
            x = column_xs[boundary]
            tag = f"resize{boundary}"
            cv.create_line(x, 0, x, bottom, fill="#94a3b8", width=5, tags=(tag,))
            cv.tag_bind(tag, "<Enter>", lambda _e: cv.configure(cursor="sb_h_double_arrow"))
            cv.tag_bind(tag, "<Leave>", lambda _e: cv.configure(cursor=""))
            cv.tag_bind(tag, "<Button-1>",
                        lambda event, i=boundary, k=width_key, w=column_widths:
                        self._start_grid_column_resize(event, k, i, w))
        cv.configure(scrollregion=(0, 0, width, bottom + 4))

    def _start_grid_column_resize(self, event, width_key, boundary, widths):
        self._column_drag = (width_key, boundary, self.cv.canvasx(event.x), list(widths))

    def _end_grid_column_resize(self, _event):
        self._column_drag = None

    def _resize_grid_column(self, event):
        if self._column_drag is None:
            return
        width_key, boundary, start_x, initial_widths = self._column_drag
        delta = self.cv.canvasx(event.x) - start_x
        min_width = min(48, initial_widths[boundary - 1], initial_widths[boundary])
        delta = min(max(delta, min_width - initial_widths[boundary - 1]),
                    initial_widths[boundary] - min_width)
        resized = list(initial_widths)
        resized[boundary - 1] += delta
        resized[boundary] -= delta
        self._grid_widths[width_key] = resized
        self.refresh_timetable()
 
    # ---- Month view
    def _draw_month(self, first, events, today):
        cv = self.cv
        width = cv.winfo_width() if cv.winfo_width() >= 100 else 900
        height = cv.winfo_height() if cv.winfo_height() >= 100 else 420
        head = self.GRID_HEADER
        start = first - timedelta(days=(first.weekday() + 1) % 7)
        last = (first + timedelta(days=32)).replace(day=1) - timedelta(days=1)
        weeks = (last - start).days // 7 + 1
        cw, ch = (width - 4) / 7, max(84, (height - head - 4) / weeks)
 
        for c, name in enumerate(("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")):
            cv.create_rectangle(2 + c * cw, 0, 2 + (c + 1) * cw, head, fill="#e6edf5", outline="#c9d3df")
            cv.create_text(2 + c * cw + cw / 2, head / 2, text=name, font=("TkDefaultFont", 10, "bold"))
 
        by_day = {}
        for e in events:
            by_day.setdefault(self._dt(e["start"]).date(), []).append(e)
        due_by_day = {}
        for due, t in self._tasks_due(start, start + timedelta(days=weeks * 7 - 1)):
            due_by_day.setdefault(due.date(), []).append(t)
 
        chars = max(6, int((cw - 12) / 5.5))
        for w in range(weeks):
            for c in range(7):
                d = start + timedelta(days=w * 7 + c)
                x0, y0 = 2 + c * cw, head + w * ch
                in_month = d.month == first.month
                tag = f"day{w}_{c}"
                fill = "#fffbe6" if d == today else ("white" if in_month else "#f3f4f6")
                cv.create_rectangle(x0, y0, x0 + cw, y0 + ch, fill=fill, outline="#d1d5db", tags=(tag,))
                cv.create_text(x0 + 5, y0 + 3, text=str(d.day), anchor="nw", tags=(tag,),
                               font=("TkDefaultFont", 9, "bold" if d == today else "normal"),
                               fill="#111827" if in_month else "#9ca3af")
                evs = sorted(by_day.get(d, []), key=lambda e: e["start"])
                due = due_by_day.get(d, [])
                room = max(1, int((ch - 22) // 14) - (1 if due else 0))
                shown = evs if len(evs) <= room else evs[:room - 1]
                y = y0 + 20
                for e in shown:
                    label = e["title"] if e["all_day"] else f"{self._dt(e['start']):%H:%M} {e['title']}"
                    if len(label) > chars:
                        label = label[:chars - 1] + "…"
                    cv.create_rectangle(x0 + 3, y, x0 + cw - 3, y + 13, fill=self._color_of(e["source"]), # type: ignore
                                        outline="", tags=(tag,))
                    cv.create_text(x0 + 5, y + 1, text=label, anchor="nw", font=("TkDefaultFont", 8), tags=(tag,))
                    y += 14
                if len(evs) > len(shown):
                    cv.create_text(x0 + 5, y + 1, text=f"+{len(evs) - len(shown)} more", anchor="nw",
                                   fill="#6b7280", font=("TkDefaultFont", 8), tags=(tag,))
                if due:
                    cv.create_text(x0 + 5, y0 + ch - 4, text=f"● {len(due)} due", anchor="sw", fill="#b00020",
                                   font=("TkDefaultFont", 8, "bold"), tags=(tag,))
                cv.tag_bind(tag, "<Button-1>", lambda _ev, d=d: self._goto_day(d))
        cv.configure(scrollregion=(0, 0, width, head + weeks * ch + 4))
 
