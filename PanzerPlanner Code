        self._build()
        self.refresh_all()
        self.after(150, self._poll_queue)
        self.after(60_000, self._tick)
        self.protocol("WM_DELETE_WINDOW", self._quit)
        if self.store.data["settings"].get("auto_sync") and self.store.sources:
            self.after(500, self.sync_all)
 
    # ---------------- layout ----------------
