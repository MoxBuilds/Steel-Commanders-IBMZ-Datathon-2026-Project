        return next((s for s in self.store.sources if s["name"] == sel[0]), None) if sel else None
 
    def edit_source(self):
        s = self._selected_source()
        if not s:
            return
        old = s["name"]
        def ok(v):
            if not v["url"] or not v["name"]:
                messagebox.showwarning("Missing info", "Name and URL are required.")
                return False
            if v["name"] != old:
                for d in (self.store.data["events"], self.store.data["last_sync"]):
                    if old in d:
                        d[v["name"]] = d.pop(old)
            s.update(v)
            self.store.save()
            self.refresh_all()
        FormDialog(self, "Edit source", self._source_fields(s), ok)
 
