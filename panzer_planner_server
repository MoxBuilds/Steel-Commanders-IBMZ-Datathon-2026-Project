# Command line
# ----------------------------------------------------------------------------
def cmd_adduser(args):
    name = args.name.strip()
    if not NAME_RE.match(name):
        sys.exit("Names are 1-40 characters: letters, numbers, spaces, - _ .")
    token = secrets.token_urlsafe(32)
    try:
        with db() as c:
            c.execute("INSERT INTO users(name, token_hash, created) VALUES(?,?,?)",
                      (name, hash_token(token), stamp()))
    except sqlite3.IntegrityError:
        sys.exit("A user called %r already exists (use resettoken to issue a new token)." % name)
    print("User %r created.\nAPI token (shown once, keep it secret):\n\n    %s\n" % (name, token))


def cmd_resettoken(args):
    token = secrets.token_urlsafe(32)
    with db() as c:
        cur = c.execute("UPDATE users SET token_hash=? WHERE name=?", (hash_token(token), args.name))
    if not cur.rowcount:
        sys.exit("No such user.")
    print("New API token for %r (the old one no longer works):\n\n    %s\n" % (args.name, token))


def cmd_listusers(args):
    with db() as c:
        for r in c.execute("SELECT u.name, u.created, (SELECT COUNT(*) FROM sources s WHERE s.user_id=u.id) n "
                           "FROM users u ORDER BY u.id"):
            print("%-24s created %s, %d calendar(s)" % (r["name"], r["created"], r["n"]))


def cmd_serve(args):
    tz = os.environ.get("PLANNER_TZ")
    if tz:
        try:
            core.set_local_tz(tz)
        except Exception as e:
            sys.exit("Bad PLANNER_TZ %r: %s (on minimal images run: pip install tzdata)" % (tz, e))
    httpd = ThreadingHTTPServer((args.host, args.port), Handler)
    httpd.daemon_threads = True
    scheme = "http"
    if args.certfile:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(args.certfile, args.keyfile)
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
        scheme = "https"
    elif args.host not in ("127.0.0.1", "localhost", "::1"):
        print("WARNING: listening on %s without TLS. Put a TLS reverse proxy in front, "
              "or use --certfile/--keyfile." % args.host, file=sys.stderr)
    threading.Thread(target=background_sync_loop, daemon=True).start()
    print("Student Planner server on %s://%s:%d  (db=%s, tz=%s, sync every %s min%s)" % (
        scheme, args.host, args.port, DB_PATH, tz or "system", SYNC_MINUTES or "never",
        ", secrets encrypted" if _fernet else ""), flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping.")


def main(argv=None):
    p = argparse.ArgumentParser(description="Student Planner server")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("serve", help="run the API server")
    s.add_argument("--host", default=os.environ.get("PLANNER_HOST", "127.0.0.1"))
    s.add_argument("--port", type=int, default=int(os.environ.get("PLANNER_PORT", "8765")))
    s.add_argument("--certfile")
    s.add_argument("--keyfile")
    s.set_defaults(fn=cmd_serve)
    a = sub.add_parser("adduser", help="create a user and print their API token")
    a.add_argument("name")
    a.set_defaults(fn=cmd_adduser)
    r = sub.add_parser("resettoken", help="issue a new API token for a user")
    r.add_argument("name")
    r.set_defaults(fn=cmd_resettoken)
    l = sub.add_parser("listusers", help="list users")
    l.set_defaults(fn=cmd_listusers)
    args = p.parse_args(argv)
    init_db()
    args.fn(args)


if __name__ == "__main__":
    main()